rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace with your admin email (same as ADMIN_EMAILS in firebase-config.js)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "sharma.yuvraj.ys1@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Public portfolio content: anyone can read, only admin can write
    match /portfolio/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact form: anyone can submit, only admin can read/delete
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'topic', 'message', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.email is string && request.resource.data.email.size() < 200
        && request.resource.data.message is string && request.resource.data.message.size() < 5000;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
